# Generate a unique key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=your-domain.example,www.your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# PostgreSQL example; URL-encode special characters in the username/password.
DATABASE_URL=postgresql://user:password@db-host:5432/database_name

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HTTPS deployment defaults these to True when DEBUG=False.
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
# Use only when a trusted HTTPS-terminating proxy overwrites this header and
# the application server is not directly reachable from untrusted clients.
TRUST_PROXY_SSL_HEADER=False
# Enable only after HTTPS is working for the entire site and its subdomains.
SECURE_HSTS_SECONDS=31536000
